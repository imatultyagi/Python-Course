   "source": [
    "#Task 8:\n",
    "import pandas as pd\n",
    "\n",
    "data = [5, None, 15, 25, None, 35, 45]\n",
    "s = pd.Series(data)\n",
    "\n",
    "# Fill missing with median\n",
    "s = s.fillna(s.median())\n",
    "\n",
    "# Filter values > 20\n",
    "s = s[s > 20]\n",
    "\n",
    "# Sort descending\n",
    "s = s.sort_values(ascending=False)\n",
    "\n",
    "# Reset index\n",
    "s = s.reset_index(drop=True)\n",
    "\n",
    "print(s)"
   ]
  }
